###############################################
# Core application settings
###############################################

NEXT_PUBLIC_SITE_URL=https://avrora.click
NEXTAUTH_URL=https://avrora.click
NEXTAUTH_SECRET=replace-with-strong-random-secret
AUTH_SECRET=${NEXTAUTH_SECRET}
PORT=4000

###############################################
# Database (PostgreSQL)
###############################################

POSTGRES_URL=
POSTGRES_MAX_CONNECTIONS=4

###############################################
# Authentication helpers
###############################################

DUMMY_PASSWORD=

###############################################
# WebSocket configuration
###############################################

WS_PORT=3001
NEXT_PUBLIC_WS_URL=wss://avrora.click/ws

###############################################
# External integrations (set only if used)
###############################################

MEGALLM_API_KEY=
REPLICATE_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=

