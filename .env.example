# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# Instructions to create an AI Gateway API key here: https://vercel.com/ai-gateway 
# API key required for non-Vercel deployments
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/postgres
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# ============ AVRORA: AI Tools API Keys ============

# Gemini API for image generation (Imagen)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=****

# Web Search API (choose one)
# Tavily API: https://tavily.com
TAVILY_API_KEY=****
# Or Brave Search API: https://brave.com/search/api/
# BRAVE_API_KEY=****

# Replicate API for Music/Video generation: https://replicate.com
REPLICATE_API_KEY=****

# Speech-to-Text Python Service
# Base URL of your Python transcription service (without /transcribe endpoint)
SPEECH_TO_TEXT_API_URL=http://localhost:8000

# Future integrations (TODO - not implemented yet)
# ElevenLabs for Text-to-Speech: https://elevenlabs.io
# ELEVENLABS_API_KEY=****

# MegaLLM API (already configured in providers.ts)
MEGALLM_API_KEY=****
