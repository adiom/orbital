# =============================================================================
# Orbital — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# Variables are grouped by criticality:
#   (A) REQUIRED  — app won't boot or core features are dead without these
#   (B) OPTIONAL  — feature-gated; the related feature is disabled when unset
#   (C) SCRIPTS   — only used by dev/test tooling, not the running app
# =============================================================================


# =============================================================================
# (A) REQUIRED
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. The app THROWS at startup if this is missing.
# Vercel Postgres / Neon / Supabase all work.
# https://vercel.com/docs/postgres
POSTGRES_URL=****

# --- Auth -------------------------------------------------------------------
# NextAuth session/JWT secret. Auth (magic-link login, sessions) breaks without it.
# Generate: `openssl rand -base64 32`  or  https://generate-secret.vercel.app/32
AUTH_SECRET=****

# --- AI provider (Ollama Cloud) ---------------------------------------------
# Primary LLM provider. WITHOUT THIS KEY, ZERO language models are registered
# and ALL AI chat / artifact features are dead (the app still boots, but every
# @Avrora request fails with "No language models available").
# Get a key at: https://ollama.com  (Ollama Cloud)
OLLAMA_API_KEY=****


# =============================================================================
# (B) OPTIONAL — feature-gated
# =============================================================================

# --- Admin station (/admin) --------------------------------------------------
# Comma-separated emails allowed into /admin and /api/admin/*.
# Empty or unset: the station returns 404 for everyone.
ADMIN_EMAILS=

# --- Redis (rate limiting + realtime) ---------------------------------------
# KV_URL is preferred; falls back to REDIS_URL, then redis://localhost:6379.
# Without Redis, rate limiting and some realtime features degrade.
# https://vercel.com/docs/redis  (or Upstash)
KV_URL=****
REDIS_URL=****

# Postgres connection pool size. Defaults: 5 (app) / 1 (migrations).
# POSTGRES_MAX_CONNECTIONS=5

# --- Magic-link email (Postmark) --------------------------------------------
# In development (NODE_ENV=development) the magic link is printed to the console
# and NO email is sent. In production these three are REQUIRED for email login.
# Verify your sender domain in Postmark first. https://postmarkapp.com
POSTMARK_SERVER_TOKEN=****
POSTMARK_FROM_EMAIL=****
# Message stream to send through. Defaults to "outbound".
# POSTMARK_MESSAGE_STREAM=outbound

# --- Base URLs (magic-link callback) ----------------------------------------
# Used to build the magic-link callback URL. NEXT_PUBLIC_SITE_URL is preferred,
# NEXTAUTH_URL is the fallback. Set at least one in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- WebSocket (realtime server) --------------------------------------------
# The WS server runs as a SEPARATE process (`pnpm dev:ws`), not inside Next.js.
# Client endpoint. Defaults to ws://localhost:3001. Use wss:// in production.
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Port the standalone WS server listens on. Defaults to 3001.
# WS_PORT=3001

# --- Ollama Cloud base URL --------------------------------------------------
# Override the Ollama Cloud endpoint. Defaults to https://ollama.com/v1.
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

# --- AI Gateway (Vercel) ----------------------------------------------------
# Required for non-Vercel deployments that route AI through Vercel AI Gateway.
# For Vercel deployments, OIDC tokens are used automatically.
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# --- File uploads (Vercel Blob) ---------------------------------------------
# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# --- Image generation (Google / Gemini Imagen) ------------------------------
# Read internally by @ai-sdk/google. Needed for image-generation tools.
# https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=****

# --- Web search tool (Tavily) -----------------------------------------------
# The web-search tool returns an error if unset. https://tavily.com
TAVILY_API_KEY=****

# --- Media generation (Replicate) -------------------------------------------
# Auth for image/video/music generation tools. https://replicate.com
REPLICATE_API_KEY=****

# --- Speech-to-text (Python service) ----------------------------------------
# Base URL of your transcription service (WITHOUT the /transcribe endpoint).
SPEECH_TO_TEXT_API_URL=http://localhost:8000
SPEECH_TO_TEXT_API_URL=https://voicer-production.up.railway.app/

# --- Text-to-speech (ElevenLabs) — NOT YET IMPLEMENTED ----------------------
# Currently only referenced in commented-out code. https://elevenlabs.io
# ELEVENLABS_API_KEY=****

# --- MegaLLM ----------------------------------------------------------------
MEGALLM_API_KEY=****

# --- Claude Code work logger ------------------------------------------------
# Where Claude Code posts work updates. Logging is skipped if either is unset.
NEXT_PUBLIC_APP_URL=https://avrora.click
CLAUDE_CODE_SFERA_ID=your-sfera-uuid-here

# --- MCP logger -------------------------------------------------------------
# Target Sfera ID for the MCP work logger.
SFERA_CLAUDE_UUID=your-sfera-uuid-here


# =============================================================================
# (C) SCRIPTS / DEV / TEST tooling only — not read by the running app
# =============================================================================

# MCP / Claude-code test scripts (scripts/test-*.ts, scripts/mcp-cli*.js)
# AVRORA_API_KEY=****
# AVRORA_BASE_URL=http://localhost:3000
# MCP_API_KEY=****

# Playwright / CI (usually set by the test runner or CI, not by hand)
# PORT=3000
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
# TEST_PRODUCTION_AUTH=false
